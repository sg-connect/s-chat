{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "s-chat",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": ["CLOUDFLARE_API_TOKEN", "FAMILY_PIN", "SESSION_SECRET"]
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FAMILY_ROOM",
        "class_name": "FamilyRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FamilyRoom"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CLOUDFLARE_ACCOUNT_ID": "5440974f62ef78f8190d5194f31a8612",
    "REALTIMEKIT_APP_ID": "db3117c6-eb5d-4af9-8891-60251b09635c",
    "REALTIMEKIT_PRESET_NAME": "group_call_host"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
